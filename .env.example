# PostgreSQL (Neon recomendado)
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="64 hex digits here"

# Cifra CPF, RG e numero de passaporte no banco (AES-256-GCM, lib/cripto.ts).
# Gere do mesmo jeito que a de cima, e com valor DIFERENTE.
#
# Variavel separada de proposito: girar a SESSION_SECRET so obriga todo mundo a
# entrar de novo; girar esta torna ilegivel o que ja esta gravado. Guarde-a onde
# guarda um backup, nao onde guarda uma senha descartavel.
#
# Deixar em branco e um MODO SUPORTADO: o app funciona inteiro e esses tres
# campos ficam em texto puro. Linha gravada antes da chave continua legivel e
# passa a ser cifrada na proxima vez que a pessoa salvar o perfil.
DADOS_SECRET=""

# Banco separado para testes (suite faz TRUNCATE)
TEST_DATABASE_URL="postgresql://user:pass@host.neon.tech/travelguide_test?sslmode=require"

# --- Assistente de IA (opcional) ---
# Sem esta chave o app funciona inteiro; só o guia se declara indisponível.
# Vive apenas no processo servidor, como a DATABASE_URL — nunca em NEXT_PUBLIC_*.
ANTHROPIC_API_KEY="sk-ant-..."

# Só para o relatório de gasto consolidado da organização. MUITO mais poderosa
# que a de cima: administra membros, workspaces e chaves. Deixe em branco a menos
# que precise do consolidado — a Admin API não atende conta individual, e o
# relatório do próprio app funciona sem ela.
ANTHROPIC_ADMIN_KEY=""

# --- Operacao (opcional) ---
# E-mails, separados por virgula, das contas que administram ESTA INSTALACAO.
# Hoje serve a uma coisa so: liberar o gasto consolidado da conta da Anthropic em
# /api/assistente/consumo. Esse numero e a fatura de quem HOSPEDA o app, nao de
# uma viagem — e como o cadastro e aberto e criar viagem ja faz de alguem
# proprietario dela, "dono da viagem" nao serve de barreira para ele.
# Vazio (o padrao) esconde essa metade do relatorio de todo mundo.
OPERADOR_EMAILS=""
